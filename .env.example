# Copy this file to .env and fill in values — never commit .env
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=headroom
POSTGRES_USER=headroom
POSTGRES_PASSWORD=changeme

# LLM backend: "local" uses Ollama, "haiku" calls Anthropic claude-haiku-4-5
LLM_PROVIDER=local
OLLAMA_MODEL=llama3.2

# Required only when LLM_PROVIDER=haiku
ANTHROPIC_API_KEY=

# Minimum weeks of positive cash runway before an amber alert is raised
SAFETY_WEEKS=4

# Vault encryption key — never commit the real value
HM_VAULT_KEY=replace_with_random_32_char_string

# Database role passwords (created by scripts/migrate.py)
HM_READER_PASSWORD=replace_me
HM_ANALYST_PASSWORD=replace_me
HM_APPROVER_PASSWORD=replace_me
HM_EVALUATOR_PASSWORD=replace_me
HM_ADMIN_PASSWORD=replace_me
